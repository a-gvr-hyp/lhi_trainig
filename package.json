{
  "name": "trainig",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "dependencies": {
    "@cap-js-community/odata-v2-adapter": "^1.15.12",
    "@cap-js/hana": "^2",
    "@sap/cds": "^9",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "0.13.6",
    "mbt": "^1.2.29",
    "rimraf": "^5.0.5"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-book": "cds watch --open book/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy trainig --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1",
    "watch-motocycle_fiori": "cds watch --open motocyclefiori/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-motocycle_freestyle": "cds watch --open motocyclefreestyle/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-motocycle_smart_elements": "cds watch --open motocyclesmartelements/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-motocycle_fcl": "cds watch --open motocyclefcl/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "cds": {},
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/book",
    "app/motocycle_fiori"
  ]
}
