<mvc:View
   controllerName="motocyclefreestyle.controller.InvoiceList"
   xmlns="sap.m"
   xmlns:core="sap.ui.core"
   xmlns:mvc="sap.ui.core.mvc">
   <List
      class="sapUiResponsiveMargin"
      id="invoiceList"
      width="auto"
      items="{
         path : '/Motocycle'
      }">
      <headerToolbar>
         <Toolbar>
            <Title text="{i18n>invoiceListTitle}"/>
            <ToolbarSpacer/>
            <SearchField 
               width="50%" 
               search=".onFilterInvoices"/>
         </Toolbar>
      </headerToolbar>
      <items>
         <ObjectListItem
            core:require="{
                  Currency: 'sap/ui/model/type/Currency'
               }"
            title="{name} - {farbe}"
            number="{
                  parts: [
                     'hubraum',
                     'view>/currency'
                 ],
                 type: 'Currency',
                 formatOptions: {
                     showMeasure: false
               }
            }"
            numberUnit="{view>/currency}"
            numberState="{= ${hubraum} > 1000 ? 'Error' : 'Success' }">
               <firstStatus>
                    <ObjectStatus
                        text="{
                            path: 'farbe',
                            formatter: '.statusText'
                        }"/>
                </firstStatus>
            </ObjectListItem>
      </items>
   </List>
</mvc:View>