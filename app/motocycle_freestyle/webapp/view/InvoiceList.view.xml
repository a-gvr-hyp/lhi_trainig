<mvc:View
   controllerName="motocyclefreestyle.controller.InvoiceList"
   xmlns="sap.m"
   xmlns:core="sap.ui.core"
   xmlns:mvc="sap.ui.core.mvc">
   <List
      class="sapUiResponsiveMargin"
      id="invoiceList"
      width="auto"
      items="{
         path : 'motocycleModel>/Motocycle'
      }">
      <headerToolbar>
         <Toolbar>
            <Title text="{i18n>invoiceListTitle}"/>
            <ToolbarSpacer/>
            <Button
               text="{i18n>addMotocycleButtonText}"
               press=".onAddMotocycle"/>
            <SearchField 
               width="50%" 
               search=".onFilterInvoices"/>
         </Toolbar>
      </headerToolbar>
      <items>
         <ObjectListItem
            core:require="{
                  Currency: 'sap/ui/model/type/Currency'
               }"
            title="{motocycleModel>name} - {motocycleModel>farbe}"
            number="{
                  parts: [
                     'motocycleModel>hubraum',
                     'view>/currency'
                 ],
                 type: 'Currency',
                 formatOptions: {
                     showMeasure: false
               }
            }"
            numberUnit="{view>/currency}"
            numberState="{= ${motocycleModel>hubraum} > 1000 ? 'Error' : 'Success' }"
            type="Navigation"
            press=".onPress">
               <firstStatus>
                    <ObjectStatus
                        text="{
                            path: 'motocycleModel>farbe',
                            formatter: '.statusText'
                        }"/>
                </firstStatus>
            </ObjectListItem>
      </items>
   </List>
</mvc:View>