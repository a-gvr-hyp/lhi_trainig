<mvc:View
	controllerName="motocyclefreestyle.controller.Update"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.uxap"
	xmlns:layout="sap.ui.layout"
	xmlns:m="sap.m"
    xmlns:core="sap.ui.core"
	xmlns:f="sap.ui.layout.form">
	<ObjectPageLayout id="ObjectPageLayoutUpdate"
		enableLazyLoading="true"
		beforeNavigate=".onBeforeNavigate"
		useIconTabBar="true"
		showTitleInHeaderContent="true"
		upperCaseAnchorBar="false">
		<headerTitle>
			<ObjectPageDynamicHeaderTitle>
				<expandedHeading>
					<m:Title text="{updateModel>/name}" wrapping="true"/>
				</expandedHeading>

				<snappedHeading>
					<m:Title text="{updateModel>/name}" wrapping="true" />
				</snappedHeading>

				<expandedContent>
					<m:Text text="{updateModel>/typ}"/>
				</expandedContent>

				<snappedContent>
					<m:Text text="{updateModel>/typ}"/>
				</snappedContent>

				<actions>
					<m:Button text="{i18n>updateButtonText}" type="Emphasized" press=".onUpdate"/>
					<m:Button type="Transparent" text="{i18n>cancelButtonText}" press=".onNavBack"/>
				</actions>
			</ObjectPageDynamicHeaderTitle>
		</headerTitle>

		<headerContent>
			<m:FlexBox wrap="Wrap" fitContainer="true" >
				<m:Label text="Hubraum: {updateModel>/hubraum}" class="sapUiSmallMarginBeginEnd"/>
				<m:Label text="Farbe: {updateModel>/farbe}" class="sapUiSmallMarginBeginEnd"/>
			</m:FlexBox>
		</headerContent>

		<sections>
			<ObjectPageSection titleUppercase="false" title="{i18n>detailPageSectionDetailsTitle}">
				<subSections>
					<ObjectPageSubSection title="{i18n>detailPageSubSectionDetailsTitle}" titleUppercase="false">
						<blocks>
							<f:SimpleForm
								editable="false"
								layout="ResponsiveGridLayout"
								title="Address"
								labelSpanXL="3"
								labelSpanL="3"
								labelSpanM="3"
								labelSpanS="12"
								adjustLabelSpan="false"
								emptySpanXL="4"
								emptySpanL="4"
								emptySpanM="4"
								emptySpanS="0"
								columnsXL="1"
								columnsL="1"
								columnsM="1"
								singleContainerFullSize="false" >
								<f:content>
									<m:Label text="Name" />
									<m:Input value="{updateModel>/name}" />
									<m:Label text="Typ" />
									<m:ComboBox id="sTypUpdate" selectedKey="{updateModel>/typ}">
                                        <core:Item key="ADV" text="ADV" />
                                        <core:Item key="SPORT" text="Sport" />
                                        <core:Item key="CHOPPER" text="Chopper" />
                                    </m:ComboBox>
									<m:Label text="Farbe" />
									<m:Input value="{updateModel>/farbe}" />
									<m:Label text="Hubraum" />
									<m:Input value="{updateModel>/hubraum}" />
								</f:content>
							</f:SimpleForm>
						</blocks>
					</ObjectPageSubSection>
				</subSections>
			</ObjectPageSection>
		</sections>
	</ObjectPageLayout>
</mvc:View>