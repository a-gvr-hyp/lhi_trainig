{
  "_version": "1.83.0",
  "sap.app": {
    "id": "motocyclefreestyle",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.22.0",
      "toolsId": "67d5f191-5576-4d0e-b01f-fdc620365ac6"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/motocycle/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      },
      "mainServiceV2": {
        "uri": "/odata/v2/motocycle/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "2.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "motocycles-display": {
          "semanticObject": "motocycles",
          "action": "display",
          "title": "{{motocycles-display.flpTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.146.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "motocyclefreestyle.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "modelV2": {
        "dataSource": "mainServiceV2",
        "preload": true
      },
      "invoiceModel": {
        "type": "sap.ui.model.json.JSONModel",
        "uri": "Invoices.json"
      },
      "motocycleModel": {
        "type": "sap.ui.model.json.JSONModel"
      },
      "createMotocycleModel": {
        "type": "sap.ui.model.json.JSONModel"
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "motocyclefreestyle.view",
        "async": true,
        "viewPath": "motocyclefreestyle.view"
      },
      "routes": [
        {
          "name": "RouteApp",
          "pattern": ":?query:",
          "target": [
            "TargetApp"
          ]
        },
        {
          "name": "Detail",
          "pattern": "detail/{motocycleId}",
          "target": [
            "Detail"
          ]
        },
        {
          "name": "Create",
          "pattern": "create",
          "target": [
            "Create"
          ]
        }
      ],
      "targets": {
        "TargetApp": {
          "id": "App",
          "name": "App"
        },
        "Detail": {
          "id": "Detail",
          "name": "Detail"
        },
        "Create": {
          "id": "Create",
          "name": "Create"
        }
      }
    },
    "rootView": {
      "viewName": "motocyclefreestyle.view.App",
      "type": "XML",
      "id": "app",
      "async": true
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "training_ag"
  }
}
