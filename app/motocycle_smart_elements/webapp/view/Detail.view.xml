<mvc:View
	controllerName="motocyclesmartelements.controller.Detail"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.uxap"
	xmlns:layout="sap.ui.layout"
	xmlns:m="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.ui.layout.form">
	<ObjectPageLayout id="ObjectPageLayout"
		enableLazyLoading="true"
		useIconTabBar="true"
		showTitleInHeaderContent="true"
		upperCaseAnchorBar="false">
		<headerTitle>
			<ObjectPageDynamicHeaderTitle>
				<expandedHeading>
					<m:Title text="{detailModel>/name}" wrapping="true"/>
				</expandedHeading>

				<snappedHeading>
					<m:Title text="{detailModel>/name}" wrapping="true" />
				</snappedHeading>

				<expandedContent>
					<m:Text text="{detailModel>/typ}"/>
				</expandedContent>

				<snappedContent>
					<m:Text text="{detailModel>/typ}"/>
				</snappedContent>

				<actions>
					<m:Button text="{i18n>editButtonText}" type="Emphasized" press=".onEdit"/>
					<m:Button type="Transparent" text="{i18n>deleteButtonText}" press=".onDelete"/>
				</actions>
			</ObjectPageDynamicHeaderTitle>
		</headerTitle>

		<headerContent>
			<m:FlexBox wrap="Wrap" fitContainer="true" >
				<m:Label text="Hubraum: {detailModel>/hubraum}" class="sapUiSmallMarginBeginEnd"/>
				<m:Label text="Farbe: {detailModel>/farbe}" class="sapUiSmallMarginBeginEnd"/>
			</m:FlexBox>
		</headerContent>

		<sections>
			<ObjectPageSection titleUppercase="false" title="{i18n>detailPageSectionDetailsTitle}">
				<subSections>
					<ObjectPageSubSection title="{i18n>detailPageSubSectionDetailsTitle}" titleUppercase="false">
						<blocks>
							<f:SimpleForm id="SimpleFormDisplay354"
								editable="false"
								layout="ResponsiveGridLayout"
								title="{i18n>masterDataTitle}"
								labelSpanXL="3"
								labelSpanL="3"
								labelSpanM="3"
								labelSpanS="12"
								adjustLabelSpan="false"
								emptySpanXL="4"
								emptySpanL="4"
								emptySpanM="4"
								emptySpanS="0"
								columnsXL="1"
								columnsL="1"
								columnsM="1"
								singleContainerFullSize="false" >
								<f:content>
									<m:Label text="Name" />
									<m:Text id="nameText" text="{detailModel>/name}" />
									<m:Label text="Typ" />
									<m:Text text="{detailModel>/typ}" />
									<m:Label text="Farbe" />
									<m:Text text="{detailModel>/farbe}" />
									<m:Label text="Hubraum" />
									<m:Text id="countryText" text="{detailModel>/hubraum}" />
									<m:Label text="Discounted Price" />
									<m:Text id="discountPriceText" text="{detailModel>/discountPrice}" />
								</f:content>
							</f:SimpleForm>
						</blocks>
					</ObjectPageSubSection>
				</subSections>
			</ObjectPageSection>

			<ObjectPageSection titleUppercase="false" title="{i18n>technicalDataSectionTitle}">
				<subSections>
					<ObjectPageSubSection title="{i18n>technicalDataSectionTitle}" titleUppercase="false">
						<blocks>
							<f:SimpleForm id="technicalDataForm"
								editable="false"
								layout="ColumnLayout"
								columnsM="2"
								columnsL="3"
								columnsXL="3">
								<f:content>
									<core:Title text="{i18n>engineGroupTitle}" />
									<m:Label text="{i18n>motorbauartLabel}" />
									<m:Text text="{path: 'detailModel>/motorbauart', formatter: '.formatter.text'}" />
									<m:Label text="{i18n>zylinderLabel}" />
									<m:Text text="{path: 'detailModel>/zylinder', formatter: '.formatter.text'}" />
									<m:Label text="{i18n>hubraumLabel}" />
									<m:Text text="{parts: [{path: 'detailModel>/hubraum'}, {value: 'ccm'}], formatter: '.formatter.withUnit'}" />
									<m:Label text="{i18n>leistungLabel}" />
									<m:Text text="{parts: [{path: 'detailModel>/leistung_ps'}, {path: 'detailModel>/leistung_kw'}], formatter: '.formatter.power'}" />
									<m:Label text="{i18n>drehmomentLabel}" />
									<m:Text text="{parts: [{path: 'detailModel>/drehmoment_nm'}, {value: 'Nm'}], formatter: '.formatter.withUnit'}" />
									<m:Label text="{i18n>kuehlungLabel}" />
									<m:Text text="{path: 'detailModel>/kuehlung', formatter: '.formatter.text'}" />
									<m:Label text="{i18n>getriebeLabel}" />
									<m:Text text="{parts: [{path: 'detailModel>/getriebe_gaenge'}, {path: 'i18n>gaengeUnit'}], formatter: '.formatter.withUnit'}" />
									<m:Label text="{i18n>antriebLabel}" />
									<m:Text text="{path: 'detailModel>/antrieb', formatter: '.formatter.text'}" />

									<core:Title text="{i18n>chassisGroupTitle}" />
									<m:Label text="{i18n>gewichtLabel}" />
									<m:Text text="{parts: [{path: 'detailModel>/gewicht_kg'}, {value: 'kg'}], formatter: '.formatter.withUnit'}" />
									<m:Label text="{i18n>tankinhaltLabel}" />
									<m:Text text="{parts: [{path: 'detailModel>/tankinhalt_l'}, {value: 'l'}], formatter: '.formatter.withUnit'}" />
									<m:Label text="{i18n>sitzhoeheLabel}" />
									<m:Text text="{parts: [{path: 'detailModel>/sitzhoehe_mm'}, {value: 'mm'}], formatter: '.formatter.withUnit'}" />
									<m:Label text="{i18n>hoechstgeschwindigkeitLabel}" />
									<m:Text text="{parts: [{path: 'detailModel>/hoechstgeschwindigkeit_kmh'}, {value: 'km/h'}], formatter: '.formatter.withUnit'}" />

									<core:Title text="{i18n>generalGroupTitle}" />
									<m:Label text="{i18n>baujahrLabel}" />
									<m:Text text="{path: 'detailModel>/jahr', formatter: '.formatter.text'}" />
									<m:Label text="{i18n>fuehrerscheinklasseLabel}" />
									<m:Text text="{path: 'detailModel>/fuehrerscheinklasse', formatter: '.formatter.text'}" />
									<m:Label text="{i18n>beschreibungLabel}" />
									<m:Text text="{path: 'detailModel>/beschreibung', formatter: '.formatter.text'}" />
									<m:Label text="{i18n>quelleLabel}" />
									<m:Link text="{path: 'detailModel>/quelle_url', formatter: '.formatter.text'}"
										href="{detailModel>/quelle_url}"
										target="_blank"
										wrapping="true"
										enabled="{= !!${detailModel>/quelle_url} }" />
								</f:content>
							</f:SimpleForm>
						</blocks>
					</ObjectPageSubSection>
				</subSections>
			</ObjectPageSection>
		</sections>
	</ObjectPageLayout>
</mvc:View>