{
  "_version": "1.86.0",
  "sap.app": {
    "id": "motocyclesmartelements",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.28.0",
      "toolsId": "135aec92-f937-41f5-872f-1c00d88fafde"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/motocycle/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      },
      "mainServiceV2": {
        "uri": "/odata/v2/motocycle/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "2.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "motocycles-smartElements": {
          "semanticObject": "motocycles",
          "action": "smartElements",
          "title": "{{motocycles-smartElements.flpTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.150.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "motocyclesmartelements.i18n.i18n"
        }
      },
      "modelV4": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "": {
        "dataSource": "mainServiceV2",
        "preload": true
      },
      "viewModel": {
        "type": "sap.ui.model.json.JSONModel"
      },
      "createMotocycleModel": {
        "type": "sap.ui.model.json.JSONModel"
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "motocyclesmartelements.view",
        "async": true,
        "viewPath": "motocyclesmartelements.view"
      },
      "routes": [
        {
          "name": "RouteApp",
          "pattern": ":?query:",
          "target": [
            "TargetApp"
          ]
        },
        {
          "name": "Detail",
          "pattern": "detail/{motocycleId}",
          "target": [
            "Detail"
          ]
        },
        {
          "name": "Update",
          "pattern": "update/{motocycleId}",
          "target": [
            "Update"
          ]
        },
        {
          "name": "Create",
          "pattern": "create",
          "target": [
            "Create"
          ]
        }
      ],
      "targets": {
        "TargetApp": {
          "id": "List",
          "name": "App"
        },
        "Detail": {
          "id": "Detail",
          "name": "Detail"
        },
        "Update": {
          "id": "Update",
          "name": "Update"
        },
        "Create": {
          "id": "Create",
          "name": "Create"
        }
      }
    },
    "rootView": {
      "viewName": "motocyclesmartelements.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "training_ag"
  }
}
