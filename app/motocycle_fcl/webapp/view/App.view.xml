<mvc:View controllerName="motocyclefcl.controller.App"
    xmlns:mvc="sap.ui.core.mvc"
    displayBlock="true"
    height="100%"
    xmlns="sap.f">
        <FlexibleColumnLayout id="flexibleColumnLayout" stateChange="onStateChanged" backgroundDesign="Solid">
            <beginColumnPages>
                <mvc:XMLView id="beginView" viewName="motocyclefcl.view.List"/>
            </beginColumnPages>
            <midColumnPages>
                <mvc:XMLView id="detailView" viewName="motocyclefcl.view.Detail"/>
            </midColumnPages>
        </FlexibleColumnLayout>
</mvc:View>