{
  "_version": "1.86.0",
  "sap.app": {
    "id": "motocyclefcl",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.30.0",
      "toolsId": "98a4b6e6-3238-44b0-bdce-96c4bb1cc989"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/motocycle/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      },
      "mainServiceV2": {
        "uri": "/odata/v2/motocycle/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "2.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "motocycles-fcl": {
          "semanticObject": "motocycles",
          "action": "fcl",
          "title": "{{motocycles-fcl.flpTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.150.1",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.f": {},
        "sap.uxap": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "motocyclefcl.i18n.i18n"
        }
      },
      "modelV4": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "products": {
        "dataSource": "mainServiceV2",
        "preload": true
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.f.routing.Router",
        "viewType": "XML",
        "async": true,
        "viewPath": "motocyclefcl.view",
        "controlAggregation": "beginColumnPages",
        "controlId": "flexibleColumnLayout",
        "transition": "slide"
      },
      "routes": [
        {
          "pattern": ":layout:",
          "name": "list",
          "target": [
            "list"
          ],
          "layout": "OneColumn"
        },
        {
          "pattern": "detail/{product}/{layout}",
          "name": "detail",
          "target": [
            "list",
            "detail"
          ],
          "layout": "TwoColumnsMidExpanded"
        }
      ],
      "targets": {
        "list": {
          "viewName": "List",
          "controlAggregation": "beginColumnPages",
          "viewId": "list"
        },
        "detail": {
          "viewName": "Detail",
          "controlAggregation": "midColumnPages",
          "viewId": "detail"
        }
      }
    },
    "rootView": {
      "viewName": "motocyclefcl.view.App",
      "type": "XML",
      "id": "fcl",
      "async": true
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "training_ag"
  }
}